ANTHROPIC_API_KEY=sk-ant-...
BRAVE_API_KEY=...
# BRAVE_MONTHLY_LIMIT=1000
# ASSISTANT_MODEL=gemma4:e4b    # run the agent on a local Ollama model (default claude-opus-5-5); judge stays on Claude
# ASSISTANT_MODEL=claude-haiku-5-5   # or a cheaper Claude model (matched Opus on every eval, 2026-10-17)
# LIBRARIAN_MODEL=claude-haiku-5-5   # model that decides what to store after each turn (default claude-opus-5-5)
# JUDGE_MODEL=claude-haiku-5-5       # source/injection check (default claude-opus-5-5); run `evals/run_eval.py judge` first
# OLLAMA_URL=http://127.0.0.1:11434
# PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006   # enable tracing (start ./run_phoenix.sh first)
